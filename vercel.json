{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/notify/*.ts": {
      "includeFiles": "api/notify/_lib.ts"
    },
    "api/trellis/*.ts": {
      "includeFiles": "api/trellis/_lib.ts,api/trellis/_sync-core.ts,api/tasks/_auto-stage.ts,api/notify/_lib.ts"
    },
    "api/cron/trellis-sync.ts": {
      "includeFiles": "api/trellis/_sync-core.ts,api/tasks/_auto-stage.ts",
      "maxDuration": 300
    },
    "api/cron/trellis-tasks-refresh.ts": {
      "includeFiles": "api/trellis/_sync-core.ts,api/tasks/_auto-stage.ts",
      "maxDuration": 300
    },
    "api/hostaway/*.ts": {
      "includeFiles": "api/hostaway/_sync-core.ts,api/notify/_lib.ts"
    },
    "api/cron/hostaway-sync.ts": {
      "includeFiles": "api/hostaway/_sync-core.ts",
      "maxDuration": 120
    },
    "api/cron/qbo-classes-sync.ts": {
      "includeFiles": "api/qbo/_lib.ts",
      "maxDuration": 60
    },
    "api/cron/qbo-pl-sync.ts": {
      "includeFiles": "api/qbo/_lib.ts,api/qbo/_pl-parse.ts",
      "maxDuration": 300
    },
    "api/issues/*.ts": {
      "includeFiles": "api/issues/_lib.ts,api/issues/_translate-core.ts,api/notify/_lib.ts"
    },
    "api/data/*.ts": {
      "includeFiles": "api/data/_lib.ts,api/issues/_lib.ts,shared/api-areas.ts"
    },
    "api/qbo/*.ts": {
      "includeFiles": "api/qbo/_lib.ts"
    },
    "api/lost-items/*.ts": {
      "includeFiles": "api/lost-items/_lib.ts"
    },
    "api/agreements/*.ts": {
      "includeFiles": "api/agreements/_lib.ts,api/notify/_lib.ts"
    },
    "api/invoices/*.ts": {
      "includeFiles": "api/invoices/_lib.ts,api/invoices/_engine.ts,api/invoices/_exporters.ts,api/qbo/_lib.ts"
    },
    "api/tasks/*.ts": {
      "includeFiles": "api/tasks/_auto-stage.ts"
    },
    "api/mcp/*.ts": {
      "includeFiles": "api/mcp/_lib.ts,api/mcp/_tools.ts,api/issues/_lib.ts,shared/crm.ts"
    },
    "api/mcp/oauth/*.ts": {
      "includeFiles": "api/mcp/_lib.ts,api/issues/_lib.ts,shared/crm.ts"
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp/metadata?doc=authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/mcp/metadata?doc=authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp/metadata?doc=protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp/metadata?doc=protected-resource"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notify/digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/trellis-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/trellis-tasks-refresh",
      "schedule": "0 0-2,12-23 * * *"
    },
    {
      "path": "/api/cron/hostaway-sync",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/qbo-classes-sync",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/qbo-pl-sync",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/purge-properties",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/purge-laundry-photos",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/reconcile-snapshots",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/archive-stale-quotes",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https://api.tendwellcleaningco.com wss://api.tendwellcleaningco.com https://*.supabase.co wss://*.supabase.co https://api.resend.com https://maps.googleapis.com https://maps.gstatic.com; font-src 'self' https://fonts.gstatic.com"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
