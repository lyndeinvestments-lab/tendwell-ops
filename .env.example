# Supabase configuration
# Get these values from your Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-side (Vite) — these are exposed to the browser, use anon key only
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Ramp API (server-side only — never expose to client)
RAMP_CLIENT_ID=your-ramp-client-id
RAMP_CLIENT_SECRET=your-ramp-client-secret

# QuickBooks Online (server-side only — never expose to client)
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret
QBO_REALM_ID=your-qbo-company-id
QBO_REDIRECT_URI=https://your-domain.com/api/qbo/callback
QBO_ENVIRONMENT=sandbox

# Anthropic (server-side only — never expose to client)
# Used by the agentic chatbot (/api/chat). Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Trellis (server-side only — never expose to client)
# Workspace API key from https://app.trellistech.com Workspace Settings.
# Used by /api/trellis/* proxy endpoints. Forwarded as the x-api-key header
# to https://api.trellistech.com/v1.
TRELLIS_API_KEY=your-trellis-workspace-api-key

# Perplexity (server-side only — never expose to client)
# Powers the chatbot's web_search / competitor_pricing / local_events_lookup /
# web_research_deep tools. Get from https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key
