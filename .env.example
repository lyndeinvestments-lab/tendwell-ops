# Supabase configuration
# Get these values from your Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-side (Vite) — these are exposed to the browser, use anon key only
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Ramp API (server-side only — never expose to client)
RAMP_CLIENT_ID=your-ramp-client-id
RAMP_CLIENT_SECRET=your-ramp-client-secret

# QuickBooks Online (server-side only — never expose to client)
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret
QBO_REALM_ID=your-qbo-company-id
QBO_REDIRECT_URI=https://your-domain.com/api/qbo/callback
QBO_ENVIRONMENT=sandbox

# Anthropic (server-side only — never expose to client)
# Used by the agentic chatbot (/api/chat). Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Trellis (server-side only — never expose to client)
# Workspace API key from https://app.trellistech.com Workspace Settings.
# Used by /api/trellis/* proxy endpoints. Forwarded as the x-api-key header
# to https://api.trellistech.com/v1.
TRELLIS_API_KEY=your-trellis-workspace-api-key

# Perplexity (server-side only — never expose to client)
# Powers the chatbot's web_search / competitor_pricing / local_events_lookup /
# web_research_deep tools. Get from https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key

# Haven-OS Lost Items proxy (server-side only — never expose to client)
# Powers /api/lost-items/* read-only proxy. Without these set, the Lost Items
# page surfaces a clean 503 error with this hint.
# - HAVEN_API_BASE_URL: root URL of the Haven-OS deployment (no trailing slash).
# - HAVEN_LOST_ITEMS_API_KEY: shared API key from Haven's HAVEN_LOST_ITEMS_API_KEY env.
#   Sent as the `x-haven-api-key` header on outbound requests.
HAVEN_API_BASE_URL=https://your-haven-os.vercel.app
HAVEN_LOST_ITEMS_API_KEY=your-haven-lost-items-api-key

# Haven-OS Reviews proxy (server-side only — never expose to client)
# Powers /api/reviews/* read-only proxy of Haven's Hostaway guest reviews
# (cleaning quality shows up in guest feedback). Without this set, the
# Reviews page surfaces a clean 503 error with a hint.
# - HAVEN_REVIEWS_API_KEY: shared API key — must equal Haven's HAVEN_REVIEWS_API_KEY.
#   Sent as the `x-haven-api-key` header. Reuses HAVEN_API_BASE_URL above.
HAVEN_REVIEWS_API_KEY=your-haven-reviews-api-key

# Issues bot API (server-side only — never expose to client)
# Powers the API-key-authenticated /api/issues and /api/issues/[id] endpoints
# so external bots/integrations can read & write the cleaning_issues table
# without holding the Supabase service-role key.
#
# PREFERRED: mint scoped keys in-app at Settings → API Keys (admin only). Those
# keys are stored (hashed) in the `api_keys` table, carry an explicit scope
# allow-list (issues:create / issues:read / issues:update), and can be revoked
# from the UI. No env var is needed to use them.
#
# ISSUES_API_KEY below is an OPTIONAL legacy fallback: if set, it authenticates
# with FULL access to every issue scope (create/read/update). Leave it unset to
# rely solely on in-app scoped keys. Generate a strong value if you do use it,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
ISSUES_API_KEY=your-issues-api-key

# Hostaway API (server-side only — never expose to client)
# Powers the nightly Hostaway listing sync + verification (Trellis Sync page →
# Hostaway tab). Create the key in Hostaway → Settings → Hostaway API.
# - HOSTAWAY_ACCOUNT_ID: your Hostaway account ID (the OAuth client_id)
# - HOSTAWAY_API_KEY: the API key (the OAuth client_secret)
HOSTAWAY_ACCOUNT_ID=your-hostaway-account-id
HOSTAWAY_API_KEY=your-hostaway-api-key
